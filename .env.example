# Copy to .env on the server and fill in. Never commit .env.

# Server (nginx proxies to this)
PORT=3000
HOST=127.0.0.1

# Canonical site URL used in sitemap.xml, canonical and OG tags (read at build time)
SITE_URL=https://incolo.si
# Optional: footer LinkedIn link (read at build time)
LINKEDIN_URL=

# Contact form
CONTACT_TO=business@incolosystems.com
CONTACT_FROM=noreply@incolosystems.com
CONTACT_SUBJECT=New enquiry — incolo.si
# LEADS_FILE=/var/lib/incolo/leads.jsonl
CONTACT_RATE_MAX=5
CONTACT_RATE_WINDOW_MIN=15

# SMTP (authenticated send). Leave SMTP_HOST empty to only save leads locally.
# GoDaddy (Workspace Email): smtpout.secureserver.net, 465, true
# Microsoft 365:             smtp.office365.com, 587, false
# Google Workspace:          smtp.gmail.com, 465, true (use an app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ---- Scoping-call booking (see docs/BOOKING-SETUP.md) ----
# Google Calendar for business@incolosystems.com (OAuth client + refresh token from `npm run google-auth`)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
# Editable settings + booking log live outside the repo
BOOKING_SETTINGS_FILE=/home/opc/incolo-data/booking-settings.json
BOOKINGS_FILE=/home/opc/incolo-data/bookings.jsonl
# Local development only: fake Meet links, invites written to outbox/ instead of sent
# BOOKING_DRY_RUN=true

# ---- /admin (from `npm run admin-password`) ----
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
